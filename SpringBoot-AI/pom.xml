<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>dev.codecounty</groupId>
        <artifactId>jspringverse-parent</artifactId>
        <version>0.0.1-SNAPSHOT</version>
        <relativePath>../pom.xml</relativePath>
        <!--    </relativePath>-->
    </parent>

    <groupId>dev.codecounty</groupId>
    <artifactId>springboot-ai</artifactId>
    <version>0.0.1-SNAPSHOT</version>
    <packaging>jar</packaging>
    <name>SpringBoot-AI</name>
    <description>Learning sandbox for Spring AI and LLM integrations</description>

    <url/>
    <licenses>
        <license/>
    </licenses>
    <developers>
        <developer/>
    </developers>
    <scm>
        <connection/>
        <developerConnection/>
        <tag/>
        <url/>
    </scm>

    <properties>
        <java.version>25</java.version>
        <!-- REMOVED: spring-ai.version — now declared in parent, no need to repeat here.
             If you ever need a different version just for this module, you can re-add it. -->
    </properties>

    <dependencies>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-webmvc</artifactId>
            <!-- No version needed: resolved via spring-boot-dependencies BOM in parent -->
        </dependency>

        <dependency>
            <groupId>org.springframework.ai</groupId>
            <artifactId>spring-ai-starter-model-ollama</artifactId>
            <!-- No version needed: resolved via spring-ai-bom in parent -->
        </dependency>

        <dependency>
            <groupId>org.springframework.ai</groupId>
            <artifactId>spring-ai-starter-model-openai</artifactId>
            <!-- No version needed: resolved via spring-ai-bom in parent -->
        </dependency>

        <!-- ===== RAG: vector store + retrieval advisor + document parsing ===== -->

        <!-- PgVector-backed VectorStore. Brings in spring-boot-starter-jdbc transitively. -->
        <dependency>
            <groupId>org.springframework.ai</groupId>
            <artifactId>spring-ai-starter-vector-store-pgvector</artifactId>
        </dependency>

        <!-- QuestionAnswerAdvisor: injects retrieved chunks into the prompt automatically. -->
        <dependency>
            <groupId>org.springframework.ai</groupId>
            <artifactId>spring-ai-vector-store-advisor</artifactId>
        </dependency>

        <!-- Apache Tika reader: parses PDF, HTML and DOCX with one API. SEC filings are
             distributed as HTML (EDGAR) or PDF (investor relations), so Tika covers both. -->
        <dependency>
            <groupId>org.springframework.ai</groupId>
            <artifactId>spring-ai-tika-document-reader</artifactId>
        </dependency>

        <!-- Conversation memory persisted to the same Postgres. JDBC rather than in-memory
             so history survives a restart and is shared across instances — an in-memory
             window silently loses context on every deploy and breaks under a load balancer. -->
        <dependency>
            <groupId>org.springframework.ai</groupId>
            <artifactId>spring-ai-starter-model-chat-memory-repository-jdbc</artifactId>
        </dependency>

        <dependency>
            <groupId>org.postgresql</groupId>
            <artifactId>postgresql</artifactId>
            <scope>runtime</scope>
        </dependency>

        <!-- Schema management. Owns all DDL: the filing registry, the vector tables and
             their indexes. Spring AI's initialize-schema is switched off accordingly.

             Must be the STARTER, not bare liquibase-core. Spring Boot 4 split
             autoconfiguration out of spring-boot-autoconfigure into per-technology modules,
             so liquibase-core alone puts the library on the classpath with no
             LiquibaseAutoConfiguration behind it: spring.liquibase.* silently does nothing
             and no migration ever runs. -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-liquibase</artifactId>
        </dependency>

        <!-- ===== Enterprise baseline ===== -->

        <!-- Bean Validation on request DTOs and @ConfigurationProperties. -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-validation</artifactId>
        </dependency>

        <!-- OpenAPI 3 spec generation + Swagger UI at /swagger-ui.html. -->
        <dependency>
            <groupId>org.springdoc</groupId>
            <artifactId>springdoc-openapi-starter-webmvc-ui</artifactId>
            <version>${springdoc.version}</version>
        </dependency>

        <!-- Health checks and metrics: /actuator/health, /actuator/metrics. -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-actuator</artifactId>
        </dependency>

        <!-- Generates metadata for our own @ConfigurationProperties so the IDE
             autocompletes them in application.properties. -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-configuration-processor</artifactId>
            <optional>true</optional>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-tomcat</artifactId>
            <scope>provided</scope>
            <!-- No version needed: resolved via spring-boot-dependencies BOM in parent -->
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-webmvc-test</artifactId>
            <scope>test</scope>
            <!-- No version needed: resolved via spring-boot-dependencies BOM in parent -->
        </dependency>

    </dependencies>

    <!-- REMOVED: <dependencyManagement> block with spring-ai-bom.
         It has been moved to the parent POM, so all child modules benefit from it. -->

    <build>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
                <!-- No version needed: resolved via pluginManagement in parent -->
            </plugin>
        </plugins>
    </build>

</project>
