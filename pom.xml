<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>dev.codecounty</groupId>
    <artifactId>jspringverse-parent</artifactId>
    <!-- CHANGED: artifactId aligned with what the child expects in <parent> block -->
    <version>0.0.1-SNAPSHOT</version>
    <!-- CHANGED: version aligned with child's <parent> version reference -->
    <packaging>pom</packaging>
    <!-- ADDED: must be 'pom' for a parent/aggregator POM -->

    <properties>
        <maven.compiler.source>25</maven.compiler.source>
        <maven.compiler.target>25</maven.compiler.target>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>

        <!-- ADDED: Centralize versions here so all child modules share one source of truth.
             Children can still override these properties locally if they need a different version. -->
        <spring-boot.version>4.1.0</spring-boot.version>
        <!-- CHANGED: RC2 -> 2.0.0 GA. Release candidates are not appropriate for an
             enterprise baseline; 2.0.0 is the stable line and is API-compatible here. -->
        <spring-ai.version>2.0.0</spring-ai.version>

        <!-- OpenAPI 3 / Swagger UI. Must be the 3.x line: springdoc 2.x targets Spring Boot 3
             and does not see Boot 4's restructured autoconfiguration modules. Not managed by
             the Spring Boot BOM, so the version is pinned here. -->
        <springdoc.version>3.0.3</springdoc.version>
    </properties>

    <dependencyManagement>
        <dependencies>

            <!-- ADDED: Import the Spring Boot BOM.
                 This pins versions for all spring-boot-starter-* and related deps
                 so child modules don't need to repeat versions on individual starters. -->
            <dependency>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-dependencies</artifactId>
                <version>${spring-boot.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>

            <!-- ADDED: Import the Spring AI BOM.
                 Pins versions for all spring-ai-* artifacts centrally.
                 Moved here from child, so any future AI module also benefits. -->
            <dependency>
                <groupId>org.springframework.ai</groupId>
                <artifactId>spring-ai-bom</artifactId>
                <version>${spring-ai.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>

        </dependencies>
    </dependencyManagement>

    <build>
        <pluginManagement>
            <!-- ADDED: Declare the Spring Boot Maven plugin version centrally.
                 Children that need it just reference the plugin without a version. -->
            <plugins>
                <plugin>
                    <groupId>org.springframework.boot</groupId>
                    <artifactId>spring-boot-maven-plugin</artifactId>
                    <version>${spring-boot.version}</version>
                </plugin>
            </plugins>
        </pluginManagement>
    </build>

</project>